---
import Main from "@/layouts/main.astro";
import NetworkGraph from "@/components/NetworkGraph";
---

<Main>
  <div class="bg-slate-950 min-h-screen">
    <div class="max-w-[1600px] mx-auto p-4 md:p-8">
      <header
        class="flex flex-col md:flex-row md:items-end justify-between mb-8 gap-4"
      >
        <div>
          <h1 class="text-4xl font-black text-white tracking-tight">
            VISTA DE TOPOLOGÍA
          </h1>
          <p
            class="text-slate-400 font-mono text-sm uppercase tracking-[0.2em] mt-1"
          >
            Consola de Monitorización SNMP v3
          </p>
        </div>
        <div
          class="flex gap-8 border-l border-slate-800 pl-8 h-12 items-center"
        >
          <div class="flex flex-col">
            <span
              class="text-[10px] text-slate-500 font-bold uppercase tracking-widest"
              >Estado Sistema</span
            >
            <span
              class="text-green-500 font-mono text-xs flex items-center gap-2"
            >
              <span class="relative flex h-2 w-2">
                <span
                  class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"
                ></span>
                <span
                  class="relative inline-flex rounded-full h-2 w-2 bg-green-500"
                ></span>
              </span>
              Sincronizado
            </span>
          </div>
        </div>
      </header>

      <NetworkGraph client:only="react" />
    </div>
  </div>
</Main>
