---
import '@/styles/global.css'
import Sidebar from '@/components/layout/Sidebar'
const { title } = Astro.props

// Get sidebar state from cookies
const sidebarCookie = Astro.cookies.get('sidebar-expanded')
const initialExpanded = sidebarCookie?.value === 'true'
const pathname = Astro.url.pathname
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="bg-black text-white selection:bg-white selection:text-black overflow-hidden">
    <div class="flex h-screen w-screen">
      <Sidebar client:load initialExpanded={initialExpanded} pathname={pathname} />
      <div class="flex-1 h-full overflow-y-auto">
        <slot />
      </div>
    </div>
  </body>
</html>
